# ============================================================
# Configuración para la demo del pipeline documental
# Copiar a .env y completar con valores reales
# ============================================================

# Twilio Sandbox
# Obtenelos en: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token_aqui
TWILIO_WHATSAPP_NUMBER=+14155238886

# Grok (xAI)
# Obtenela en: https://console.x.ai
XAI_API_KEY=xai-tu-key-aqui
# Modelo a usar (default: grok-2-vision-1212)
# XAI_MODEL=grok-2-vision-1212

# Google Drive
# Service account JSON key file
# Obtenelo en: Google Cloud Console > IAM > Service Accounts
GOOGLE_DRIVE_CREDENTIALS=./service-account-key.json
# ID de la carpeta raíz de Drive (extraelo de la URL: https://drive.google.com/drive/folders/<ID>)
GOOGLE_DRIVE_FOLDER_ID=1a2b3c4d5e6f7g8h9i0j

# Base de datos
DATABASE_PATH=./data/processing.db

# Servidor
HOST=0.0.0.0
PORT=8000

# Límites
MAX_FILE_SIZE_MB=15
CLASSIFICATION_TIMEOUT_S=15
